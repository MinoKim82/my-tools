# Google Drive 'areas/family' 폴더 ID (기본값 설정됨)
GOG_FAMILY_FOLDER_ID=1PaB7zVl7WsQCmODRxBRpImxFMa0fkV1q

# 스프레드시트 파일명 (구글 드라이브 내)
